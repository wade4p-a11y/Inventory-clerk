{
  "expo": {
    "name": "Inventory Clerk",
    "slug": "inventory-clerk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "inventory-clerk",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B3A2F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lakecowal.inventoryclerk",
      "infoPlist": {
        "NSCameraUsageDescription": "Photograph inventory stock for audit records.",
        "NSLocationWhenInUseUsageDescription": "Suggest a stock location from GPS when outdoors.",
        "NSPhotoLibraryUsageDescription": "Attach an existing photo to an inventory item."
      }
    },
    "android": {
      "package": "com.lakecowal.inventoryclerk",
      "adaptiveIcon": {
        "backgroundColor": "#1B3A2F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Photograph inventory stock for audit records.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Suggest a stock location from GPS when outdoors."
        }
      ],
      "expo-mail-composer",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
